---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  const date = d.toISOString().slice(0, 10);
  const time = d.toTimeString().slice(0, 5);
  return `${date} · ${time}`;
}
---

<Base title="unmolted">
  <ul class="post-list">
    {all.map((item) => (
      <li>
        <span class="post-date">
          {formatDate(item.data.date)}
        </span>
        <a href={`/posts/${item.id}`} class="post-title-link">{item.data.title}</a>
        <p class="post-excerpt">{item.data.description}</p>
      </li>
    ))}
  </ul>

  {all.length === 0 && (
    <p style="color: var(--text-muted); font-family: var(--font-mono); font-size: 0.9rem;">
      nothing here yet. still molting.
    </p>
  )}
</Base>
